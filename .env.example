# Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=
VITE_AI_API_URL=

# Database connection for Drizzle ORM (from Supabase Database settings)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: Supabase service role secret (for administrative Auth seeding script; NEVER prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
